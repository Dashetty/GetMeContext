# ── Required ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional overrides ───────────────────────────────────
# Chat model used for answers (and follow-up rewriting).
# Free-tier friendly default with the highest quota (~500 req/day).
# Quality upgrade (lower quota): gemini-4-hydrogen
# Previous-gen Flash (~20 req/day): gemini-3.8-flash
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# Embedding model used for retrieval. Keep the -001 text model: the LangChain
# wrapper relies on its task_type support. gemini-embedding-2 uses prompt
# prefixes and aggregates multi-input requests differently.
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# Retrieval and chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Number of previous Q&A turns used as chat memory
CONVERSATION_WINDOW=3

# Where ChromaDB persists locally (ephemeral on Streamlit Cloud)
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=docquery_docs
